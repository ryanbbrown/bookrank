server {
    listen 80;

    server_name localhost;

    location / {
        root /home/ryanbrown/projects/bookrank/app/djangoapp/static;
        try_files $uri /index.html;
    }

    # location / {
        # proxy_pass http://localhost:3000;
        # proxy_set_header Host $host;
        # proxy_set_header X-Real-IP $remote_addr;
        # proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # proxy_set_header X-Forwarded-Proto $scheme;
    # }

    location /static/ {
        alias /home/ryanbrown/projects/bookrank/app/djangoapp/static/static/;
    }

    location /api/ {
    	# this is for local testing setup OR local docker setup OR digitalocean docker setup
        proxy_pass http://127.0.0.1:8000;

        # this is for local gunicorn setup
        # proxy_pass http://unix:/home/ryanbrown/projects/bookrank/app/djangoapp/gunicorn.sock;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-CSRFToken $http_x_csrf_token;  # Forward the CSRF token
        proxy_set_header Cookie $http_cookie;  # Forward cookies
        proxy_set_header Authorization $http_authorization;  # Forward the Authorization header
        proxy_set_header Origin $http_origin;  # Forward the Origin header
        proxy_set_header Referer $http_referer;  # Forward the Referer header
    }
}
